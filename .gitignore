# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
scripts/.future-demo-world-state.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Preview/Staging E2E local secrets (belt-and-suspenders; already matched by .env*)
.env.preview-e2e.local
**/gmail-e2e-token.json
**/gmail-oauth-client.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Agent run logs (per-task evidence, local only — infra itself is committed)
/.agent/tasks/*
!/.agent/tasks/.gitkeep
/.agent/reviews/*
!/.agent/reviews/.gitkeep
/.agent/runtime/*
!/.agent/runtime/.gitkeep

# Local audit / P0 temp artifacts (may contain Production secrets)
.tmp-ogp-p0/
.tmp-*.json
.tmp-*.out
.tmp-ogp-diff-*/
**/prod-service.env
.tmp-ogp-repair/
