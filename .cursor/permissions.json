{
  // Forge project terminal allowlist + Auto-review steering.
  // Docs: https://cursor.com/docs/reference/permissions.md
  //
  // Owner chat instruction = scoped approval for that whole task.
  // Do NOT re-ask commit / Preview push / Staging migration / main / Production
  // when the owner already instructed that scope.
  //
  // Run Mode: owner prefers full-auto for Preview + instructed Production code
  // release. Production Supabase writes remain owner-manual (see block_instructions).
  // Do NOT add ultra-broad prefixes: "git", "npm", "npx", "curl", "rm".

  "terminalAllowlist": [
    "pwd",
    "ls",
    "dir",
    "Get-ChildItem",
    "Get-Location",
    "Get-Content",
    "Select-String",
    "Get-Process",
    "Stop-Process",
    "Test-Path",
    "Write-Host",
    "Write-Output",
    "echo",
    "cat",
    "type",
    "head",
    "tail",
    "find",
    "where.exe",
    "which",

    "rg",
    "ripgrep",

    "git status",
    "git diff",
    "git log",
    "git show",
    "git branch",
    "git rev-parse",
    "git remote",
    "git stash list",
    "git describe",
    "git ls-files",
    "git fetch",
    "git pull",
    "git add",
    "git commit",
    "git merge",
    "git checkout",
    "git switch",

    "git push origin preview/landing-01",
    "git push -u origin preview/landing-01",
    "git push origin HEAD:preview/landing-01",
    "git push -u origin HEAD:preview/landing-01",
    "git push origin main",
    "git push -u origin main",
    "git push origin HEAD:main",
    "git push origin HEAD",

    "npm run typecheck",
    "npm run build",
    "npm run lint",
    "npm run test",
    "npm test",
    "npm run verify:",
    "npm run check:",
    "npm run dev",
    "npm run start",
    "npx tsc --noEmit",
    "npx --yes tsc --noEmit",
    "npx next dev",
    "npx next build",
    "npx --yes tsx scripts/",
    "npx tsx scripts/",
    "npx --yes tsx .tmp-",
    "npx tsx .tmp-",
    "node scripts/",
    "node .tmp-",

    "Remove-Item .tmp-",
    "Remove-Item -Force .tmp-",
    "Remove-Item -Recurse -Force .tmp-",
    "rm .tmp-",
    "rm -f .tmp-",
    "rm -rf .tmp-",
    "del .tmp-",

    "npx vercel ls",
    "npx vercel list",
    "npx vercel inspect",
    "npx vercel logs",
    "npx vercel deploy",
    "npx vercel --prod",
    "npx vercel promote",
    "vercel ls",
    "vercel list",
    "vercel inspect",
    "vercel logs",
    "vercel deploy",
    "vercel --prod",
    "vercel promote",

    "curl -I",
    "curl -sI",
    "curl --head",
    "curl -sL https://forge-flame-gamma.vercel.app",
    "curl -s https://forge-flame-gamma.vercel.app",
    "curl -sL https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -s https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -I https://forge-flame-gamma.vercel.app",
    "curl -I https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -sI https://forge-flame-gamma.vercel.app",
    "curl -sI https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -I http://localhost",
    "curl -sI http://localhost",
    "curl -I http://127.0.0.1",
    "curl -sI http://127.0.0.1",
    "curl -s http://localhost",
    "curl -s http://127.0.0.1",
    "curl -sL http://localhost",
    "curl -sL http://127.0.0.1"
  ],

  "autoRun": {
    "allow_instructions": [
      "Treat the owner's explicit chat instruction as approval for the stated scope. Do not re-ask commit, Preview push, Staging migration, code Production deploy, or smoke inside that scope.",
      "Phrases like 本番反映して / リリースして (and equivalents) are one-shot approval for: main reflect+push, Vercel Production deploy/promote, Production smoke, changelog, and main↔preview sync — no per-step confirmation.",
      "Always allow Staging Supabase (vuqpwvjvgyxffmvpfrxo) migration, CRUD, seed, backfill, RPC, Storage, service-role verification, and smoke/cleanup without asking.",
      "For ordinary fixes: investigation, edits, verify/build/test, commit, preview/landing-01 push, Preview deploy, Preview smoke without asking.",
      "Allow Production Supabase (bpnisgzxuwdxelhnduuf) read-only SELECT/REST GET/read-only RPC/counts anytime.",
      "Owner prefers full-auto Run Mode for Preview and instructed Production code release. Prefer execution paths that avoid extra ALLOW cards."
    ],
    "block_instructions": [
      "Do NOT execute Production Supabase migration, INSERT, UPDATE, DELETE, backfill, or Storage writes yourself. Those are owner-manual even under full-auto Run Mode. Provide SQL, order, impact, and verification queries instead; after the owner applies, run read-only verify and smoke.",
      "Stop and ask only for: unrelated uncommitted diffs mixing into Production release; inability to identify target env/rows or missing Staging apply credentials; unexpectedly large mass changes; unsolicited force push/history rewrite/broad delete; or displaying raw secrets/JWTs/service-role/.env contents. Also stop if data changes beyond scope are required or a newly discovered major risk appears.",
      "Block force push, git reset --hard, and git clean unless the owner explicitly requested that irreversible action.",
      "Block printing or copying secret values into chat or terminal output.",
      "If Production code release was NOT instructed (no 本番反映して / リリースして / equivalent), do not start main push or vercel --prod after Preview."
    ]
  }
}
