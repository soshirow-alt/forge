{
  // Forge project terminal allowlist + Auto-review steering.
  // Docs: https://cursor.com/docs/reference/permissions.md
  //
  // Owner chat instruction = scoped approval for that whole task.
  // Do NOT re-ask commit / Preview push / Staging migration / main / Production
  // when the owner already instructed that scope.
  //
  // Keep Run Mode = Auto-review (do NOT use Run Everything).
  // Do NOT add ultra-broad prefixes: "git", "npm", "npx", "curl", "rm".

  "terminalAllowlist": [
    "pwd",
    "ls",
    "dir",
    "Get-ChildItem",
    "Get-Location",
    "Get-Content",
    "Select-String",
    "Get-Process",
    "Stop-Process",
    "Test-Path",
    "Write-Host",
    "Write-Output",
    "echo",
    "cat",
    "type",
    "head",
    "tail",
    "find",
    "where.exe",
    "which",

    "rg",
    "ripgrep",

    "git status",
    "git diff",
    "git log",
    "git show",
    "git branch",
    "git rev-parse",
    "git remote",
    "git stash list",
    "git describe",
    "git ls-files",
    "git fetch",
    "git pull",
    "git add",
    "git commit",
    "git merge",
    "git checkout",
    "git switch",

    "git push origin preview/landing-01",
    "git push -u origin preview/landing-01",
    "git push origin HEAD:preview/landing-01",
    "git push -u origin HEAD:preview/landing-01",
    "git push origin main",
    "git push -u origin main",
    "git push origin HEAD:main",
    "git push origin HEAD",

    "npm run typecheck",
    "npm run build",
    "npm run lint",
    "npm run test",
    "npm test",
    "npm run verify:",
    "npm run check:",
    "npm run dev",
    "npm run start",
    "npx tsc --noEmit",
    "npx --yes tsc --noEmit",
    "npx next dev",
    "npx next build",
    "npx --yes tsx scripts/",
    "npx tsx scripts/",
    "npx --yes tsx .tmp-",
    "npx tsx .tmp-",
    "node scripts/",
    "node .tmp-",

    "Remove-Item .tmp-",
    "Remove-Item -Force .tmp-",
    "Remove-Item -Recurse -Force .tmp-",
    "rm .tmp-",
    "rm -f .tmp-",
    "rm -rf .tmp-",
    "del .tmp-",

    "npx vercel ls",
    "npx vercel list",
    "npx vercel inspect",
    "npx vercel logs",
    "npx vercel deploy",
    "npx vercel --prod",
    "npx vercel promote",
    "vercel ls",
    "vercel list",
    "vercel inspect",
    "vercel logs",
    "vercel deploy",
    "vercel --prod",
    "vercel promote",

    "curl -I",
    "curl -sI",
    "curl --head",
    "curl -sL https://forge-flame-gamma.vercel.app",
    "curl -s https://forge-flame-gamma.vercel.app",
    "curl -sL https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -s https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -I https://forge-flame-gamma.vercel.app",
    "curl -I https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -sI https://forge-flame-gamma.vercel.app",
    "curl -sI https://forge-git-preview-landing-01-soshirow-alts-projects.vercel.app",
    "curl -I http://localhost",
    "curl -sI http://localhost",
    "curl -I http://127.0.0.1",
    "curl -sI http://127.0.0.1",
    "curl -s http://localhost",
    "curl -s http://127.0.0.1",
    "curl -sL http://localhost",
    "curl -sL http://127.0.0.1"
  ],

  "autoRun": {
    "allow_instructions": [
      "Treat the owner's explicit chat instruction as approval for the entire stated scope. After they say things like apply to Staging, go to Preview, release to production, apply Production migration, or release this fix: do not ask again for commit, Preview push, Staging migration, main push, Production deploy, scoped Production DB/storage changes, or smoke.",
      "Always allow Staging (vuqpwvjvgyxffmvpfrxo) migration, SELECT/INSERT/UPDATE/DELETE, seed, backfill, RPC, Storage write/delete, service-role verification, smoke data create/cleanup without asking.",
      "For ordinary fix/investigate requests, allow investigation, edits, verify/typecheck/lint/build/test, commit, preview/landing-01 push, Preview deploy (including vercel deploy), Preview smoke end-to-end without asking.",
      "When the owner already instructed Production release or Production DB apply, allow main merge/push, vercel --prod/promote, required Production migrations/DB writes/Storage ops for that feature, Production smoke, changelog, and main/preview branch sync without re-asking.",
      "Allow Production Supabase (bpnisgzxuwdxelhnduuf) read-only anytime; allow Production writes only when the owner's current instruction includes Production apply/release.",
      "Prefer execution paths that avoid extra ALLOW cards. Do not stop to ask for smoke permission.",
      "Allow in-repo .tmp-* audit scripts and deleting .tmp-* only."
    ],
    "block_instructions": [
      "Stop and ask only for: unrelated uncommitted diffs mixing into a Production release; data changes beyond the requested scope; unexpectedly large UPDATE/DELETE; inability to uniquely identify target env/rows; newly discovered major risk vs the brief; unsolicited force push / history rewrite / broad delete; or displaying raw secrets/JWTs/service-role/.env contents to the user.",
      "Block force push, git reset --hard, and git clean unless the owner explicitly requested that irreversible action.",
      "Block printing or copying secret values, JWTs, service role keys, or full .env contents into chat or terminal output.",
      "Block npm install/ci/package add/update/remove and deletes outside this repository unless the owner explicitly asked.",
      "If Production was NOT instructed in this task, do not start main push or vercel --prod on your own after Preview."
    ]
  }
}
